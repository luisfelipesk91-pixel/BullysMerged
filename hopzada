-- Busca até 4 páginas alternando sortOrder — pool de ~400 servidores por rodada
-- O ACCOUNT_POOL_OFFSET faz cada conta começar numa ordem diferente,
-- então as 18 instâncias não disputam exatamente os mesmos servidores
local function fetchAllServers(placeId)
    local allServers = {}
    local seenIds    = {}

    local orders = ACCOUNT_POOL_OFFSET % 2 == 0
        and {"Asc", "Desc"}
        or  {"Desc", "Asc"}

    for _, sortOrder in ipairs(orders) do
        local cursor = nil
        for page = 1, 2 do  -- 2 páginas × 2 ordens = até 400 servidores
            local url = "https://games.roblox.com/v1/games/" .. placeId
                        .. "/servers/Public?sortOrder=" .. sortOrder .. "&limit=100"
            if cursor and cursor ~= "" then
                url = url .. "&cursor=" .. HttpService:UrlEncode(cursor)
            end

            local ok, result = pcall(function()
                return HttpService:JSONDecode(game:HttpGet(url))
            end)

            if not ok or not result or not result.data then break end

            for _, server in ipairs(result.data) do
                if not seenIds[server.id] then
                    seenIds[server.id] = true
                    table.insert(allServers, server)
                end
            end

            cursor = result.nextPageCursor
            if not cursor or cursor == "" then break end
            task.wait(0.2)  -- respeita rate limit da API
        end
        task.wait(0.15)
    end

    return allServers
end

-- Pontua o servidor: prefere baixo pop (mais fresco, brainrots intactos)
-- Randomização embutida pra as 18 contas não escolherem o mesmo servidor
local function scoreServer(server)
    local playing    = server.playing    or 0
    local maxPlayers = server.maxPlayers or 8
    if playing >= maxPlayers then return -1 end  -- cheio, pula

    local score
    if    playing <= 2 then score = 100  -- quase vazio → mais provável ter loot
    elseif playing <= 4 then score = 80
    elseif playing <= 6 then score = 50
    else                     score = 20  -- pop alta → já visitado por muitos
    end

    -- Ruído aleatório evita que todas as contas escolham o mesmo top-1
    return score + math.random(0, 35)
end

local function startInfiniteHop(label)
    print("[HOP] Sistema multi-página iniciado...")
    if not game:IsLoaded() then game.Loaded:Wait() end
    task.wait(0.3)

    local visited = getVisitedServers()
    visited[game.JobId] = os.time()
    saveVisitedServers(visited)

    local consecutiveFails = 0

    while true do
        local now          = os.time()
        local curVisited   = getVisitedServers()

        -- Expirar entradas antigas
        for id, ts in pairs(curVisited) do
            if now - ts > VISITED_EXPIRY then curVisited[id] = nil end
        end

        text.Text = "🔍 Buscando servidores novos..."

        local allServers = fetchAllServers(PLACE_ID)
        print("[HOP] Pool total: " .. #allServers .. " servidores")

        -- Filtrar e pontuar candidatos
        local candidates = {}
        for _, server in ipairs(allServers) do
            if server.id == game.JobId  then continue end
            if curVisited[server.id]    then continue end
            local score = scoreServer(server)
            if score > 0 then
                table.insert(candidates, { server = server, score = score })
            end
        end

        if #candidates == 0 then
            consecutiveFails = consecutiveFails + 1
            print("[HOP] Sem candidatos. Falhas consecutivas: " .. consecutiveFails)

            if consecutiveFails >= 3 then
                -- Pool esgotado: remove 50% dos visitados mais antigos e tenta de novo
                local entries = {}
                for id, ts in pairs(curVisited) do
                    table.insert(entries, { id = id, ts = ts })
                end
                table.sort(entries, function(a, b) return a.ts < b.ts end)
                local removeCount = math.max(1, math.floor(#entries * 0.5))
                for i = 1, removeCount do curVisited[entries[i].id] = nil end
                saveVisitedServers(curVisited)
                consecutiveFails = 0
                text.Text = "🔄 Cache parcial limpo — buscando novos..."
                print("[HOP] Cache parcial limpo (" .. removeCount .. " entradas removidas)")
                task.wait(2)
            else
                text.Text = "⏳ Sem novos servidores (" .. #allServers .. " verificados)..."
                task.wait(4)
            end
            continue
        end

        consecutiveFails = 0

        -- Escolhe aleatoriamente entre os top 10 pontuados
        table.sort(candidates, function(a, b) return a.score > b.score end)
        local topN   = math.min(10, #candidates)
        local chosen = candidates[math.random(1, topN)].server

        text.Text = "📡 " .. label .. " → " .. string.sub(chosen.id, 1, 8)
                    .. "... (" .. chosen.playing .. "/" .. (chosen.maxPlayers or 8) .. ")"
        print("[HOP] → " .. chosen.id .. " | Players: " .. chosen.playing
              .. "/" .. (chosen.maxPlayers or 8) .. " | Pool disponível: " .. #candidates)

        curVisited[chosen.id] = os.time()
        saveVisitedServers(curVisited)

        local ok, err = pcall(function()
            TeleportService:TeleportToPlaceInstance(PLACE_ID, chosen.id, LocalPlayer)
        end)

        if not ok then
            print("[HOP] ⚠️ Teleporte falhou: " .. tostring(err))
            -- Remove da lista visitada — servidor pode estar acessível depois
            curVisited[chosen.id] = nil
            saveVisitedServers(curVisited)
        end

        task.wait(2)
    end
end

