local function calculateGenValue(name, mutation, traitsTable)
    if not AnimalsData or not AnimalsData[name] then return nil end
    
    -- Base generation (sem mutation/traits)
    local baseGen = nil
    local ok1, result1 = pcall(function() return _G._xenGen(name, nil, nil) end)
    if ok1 and type(result1) == "number" and result1 > 0 then 
        baseGen = result1
    end
    
    if not baseGen then
        baseGen = AnimalsData[name].Generation
        if not baseGen or type(baseGen) ~= "number" or baseGen <= 0 then
            return nil
        end
    end
    
    -- Mutation multiplier (✅ usa cache)
    local mutationMod = mutation and MUTATION_MODS[mutation] or 1
    
    -- Traits sum (✅ usa cache)
    local traitsSum = 0
    local hasSleepy = false
    
    if traitsTable and #traitsTable > 0 then
        for _, trait in ipairs(traitsTable) do
            if trait == "Sleepy" then
                hasSleepy = true
            else
                traitsSum = traitsSum + (TRAIT_MODS[trait] or 0)
            end
        end
    end
    
    -- Calcular: Base × (Mutation + TraitsSum)
    local genValue = baseGen * (mutationMod + traitsSum)
    
    -- Aplicar Sleepy por último (× 0.5)
    if hasSleepy then
        genValue = genValue * 0.5
    end
    
    return genValue
end

