local function parseObjectText(objectText)
    if not objectText or objectText == "" then return nil, 0 end
    local name, valStr = objectText:match("^(.-)%s*%$([%d%.]+[KkMmBbTt]?)%s*$")
    if name and valStr then
        name = name:match("^%s*(.-)%s*$")
        return name, parseValue("$" .. valStr .. "/s")
    end
    return objectText:match("^%s*(.-)%s*$"), 0
end

-- Leitura leve: não chama GetDescendants dentro de cada prompt.
local function canonicalDataKey(value, dataMap)
    if value == nil then return nil end
    local normalized = tostring(value):gsub("^%s+", ""):gsub("%s+$", "")
    for key in pairs(dataMap) do
        if tostring(key):lower() == normalized:lower() then return key end
    end
    return normalized ~= "" and normalized or nil
end

local function findPromptData(prompt)
    local promptText = tostring(prompt.ObjectText or "")
    local texts = { promptText }
    local traitTexts = {}
    local mutationTexts = {}
    local promptTextLower = promptText:lower()
    if promptTextLower:find("trait", 1, true) then table.insert(traitTexts, promptText) end
    if promptTextLower:find("mutation", 1, true) then table.insert(mutationTexts, promptText) end
    local nodes = { prompt }
    local ancestor = prompt.Parent
    for _ = 1, 6 do
        if not ancestor or ancestor == Workspace then break end
        table.insert(nodes, ancestor)
        ancestor = ancestor.Parent
    end
    for _, node in ipairs(nodes) do
        table.insert(texts, tostring(node.Name or ""))
        for key, attr in pairs(node:GetAttributes()) do
            local keyLower = tostring(key):lower()
            local valueText = tostring(attr or "")
            if keyLower:find("mutation", 1, true) then
                table.insert(mutationTexts, valueText)
            elseif keyLower:find("trait", 1, true) then
                table.insert(traitTexts, valueText)
            end
        end
        for _, child in ipairs(node:GetChildren()) do
            table.insert(texts, tostring(child.Name or ""))
            for key, attr in pairs(child:GetAttributes()) do
                local keyLower = tostring(key):lower()
                local attrText = tostring(attr or "")
                if keyLower:find("mutation", 1, true) then
                    table.insert(mutationTexts, attrText)
                elseif keyLower:find("trait", 1, true) then
                    table.insert(traitTexts, attrText)
                end
            end
            local childNameLower = tostring(child.Name or ""):lower()
            local childValue = ""
            if child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("TextBox") then
                childValue = tostring(child.Text or "")
                table.insert(texts, childValue)
            elseif child:IsA("StringValue") or child:IsA("IntValue") or child:IsA("NumberValue") then
                childValue = tostring(child.Value or "")
                table.insert(texts, childValue)
            end
            -- Só trata o conteúdo como trait/mutation quando o objeto indica explicitamente isso.
            if childNameLower:find("trait", 1, true) then
                table.insert(traitTexts, childValue)
            elseif childNameLower:find("mutation", 1, true) then
                table.insert(mutationTexts, childValue)
            end
        end
    end

    local name, value, mutation, traits = nil, 0, nil, {}
    for _, text in ipairs(texts) do
        local parsedName, parsedValue = parseObjectText(text)
        if parsedValue and parsedValue > value then value = parsedValue end
        -- Traits e mutation são processados abaixo somente das fontes explicitamente marcadas.

        if AnimalsData then
            local lowText = text:lower()
            for candidate in pairs(AnimalsData) do
                if lowText:find(tostring(candidate):lower(), 1, true) then name = candidate break end
            end
        end
        -- Não usa textos genéricos de filhos (números, traits ou mutações) como nome.
        -- O nome válido deve vir de AnimalsData; isso evita casos como "67".
    end

    for _, sourceText in ipairs(mutationTexts) do
        local lowText = tostring(sourceText):lower()
        for candidate in pairs(MUTATION_MODS) do
            if candidate ~= "Default" and lowText:find(tostring(candidate):lower(), 1, true) then
                mutation = canonicalDataKey(candidate, MUTATION_MODS)
                break
            end
        end
        if mutation then break end
    end

    for _, sourceText in ipairs(traitTexts) do
        local lowText = tostring(sourceText):lower()
        for candidate in pairs(TRAIT_MODS) do
            if lowText:find(tostring(candidate):lower(), 1, true) then
                local canonical = canonicalDataKey(candidate, TRAIT_MODS)
                local already = false
                for _, existing in ipairs(traits) do
                    if existing == canonical then already = true break end
                end
                if not already then table.insert(traits, canonical) end
            end
        end
    end

    return name, value, mutation, traits
end

local function scanCarpet(seen, currentJobId)
    local results = {}
    local baseResults = {}
    local carpetCount = 0
    local promptTotal = 0
    local disabledCount = 0
    local actionMismatch = 0
    local noNameCount = 0
    local blacklistedCount = 0
    local lowValueCount = 0
    local uniqueResults = {}
    
    --print("[SCAN DEBUG] ===== INICIO SCAN CARPET =====")
    --print("[SCAN DEBUG] AnimalsData=" .. tostring(type(AnimalsData)) .. " entries=" .. tostring(AnimalsData and #AnimalsData or 0))
    
    -- Uma única varredura geral do Workspace.
    local descendants = Workspace:GetDescendants()
    
    for _, obj in ipairs(descendants) do
        if not obj:IsA("ProximityPrompt") then continue end
        promptTotal = promptTotal + 1
        local action = tostring(obj.ActionText or "")
        local objectText = tostring(obj.ObjectText or "")
        local parentName = obj.Parent and obj.Parent:GetFullName() or "nil"
        --print(string.format("[SCAN DEBUG] Prompt #%d enabled=%s action=%q object=%q parent=%s", promptTotal, tostring(obj.Enabled), action, objectText, parentName))
        if not obj.Enabled then
            disabledCount = disabledCount + 1
            --print("[SCAN DEBUG] DESCARTADO: prompt desabilitado")
            continue
        end
        local actionLower = action:lower()
        -- Brainrots já colocados em bases usam "Steal", não "Purchase".
        if actionLower ~= "purchase" and actionLower ~= "steal" then
            actionMismatch = actionMismatch + 1
            --print("[SCAN DEBUG] DESCARTADO: ActionText não é Purchase nem Steal")
            continue
        end
        
        carpetCount = carpetCount + 1
        local displayName, genValue, mutation, traits = findPromptData(obj)
        --print(string.format("[SCAN DEBUG] Dados extraidos: nome=%q valorTexto=%s", tostring(displayName), tostring(genValue)))
        if not displayName or displayName == "" then
            noNameCount = noNameCount + 1
            --print("[SCAN DEBUG] DESCARTADO: nenhum nome encontrado no prompt/pai/filhos imediatos")
            continue
        end
        
        if isBlacklisted(displayName) then
            blacklistedCount = blacklistedCount + 1
            --print("[SCAN DEBUG] DESCARTADO: blacklist -> " .. tostring(displayName))
            continue
        end
        
        local dataName = displayName
        if not (AnimalsData and AnimalsData[dataName]) and AnimalsData then
            local lowName = displayName:lower()
            for candidate in pairs(AnimalsData) do
                if tostring(candidate):lower() == lowName then dataName = candidate break end
            end
        end
        --print(string.format("[SCAN DEBUG] AnimalsData lookup: display=%q dataName=%q existe=%s", tostring(displayName), tostring(dataName), tostring(AnimalsData and AnimalsData[dataName] ~= nil)))
        if AnimalsData and AnimalsData[dataName] then
            local calculatedValue = calculateGenValue(dataName, mutation, traits)
            --print("[SCAN DEBUG] Generation calculada: " .. tostring(calculatedValue))
            if calculatedValue and calculatedValue > 0 then genValue = calculatedValue end
        else
            --print("[SCAN DEBUG] AVISO: nome nao encontrado em AnimalsData")
        end
        
        local qualifiesValue = genValue >= MIN_VALUE_CARPET
        local qualifiesTarget = isTargeted(displayName)
        local qualifiesUltra = isUltra(displayName)
        --print(string.format("[SCAN DEBUG] Filtros: valor=%s (min=%s) targeted=%s ultra=%s", tostring(qualifiesValue), tostring(MIN_VALUE_CARPET), tostring(qualifiesTarget), tostring(qualifiesUltra)))
        if not (qualifiesValue or qualifiesTarget or qualifiesUltra) then
            lowValueCount = lowValueCount + 1
            --print("[SCAN DEBUG] DESCARTADO: valor abaixo do minimo e nao targeted/ultra")
            continue
        end
        
        local genText = genValue > 0 and ("$" .. formatValue(genValue) .. "/s") or "?"
        local tier = (genValue >= 1e9 or isUltra(displayName)) and "ULTRA" 
                  or (genValue >= 100e6) and "HIGH" 
                  or "MID"
        
        -- Purchase = esteira/carpet; Steal = brainrot já colocado em uma base.
        local isBasePrompt = actionLower == "steal"
        local resultOwner = "Carpet"
        if isBasePrompt then
            local node = obj.Parent
            while node and node ~= Workspace do
                if node.Parent and node.Parent.Name == "Plots" then
                    resultOwner = tostring(node:GetAttribute("Owner") or node:GetAttribute("PlayerName") or node.Name)
                    break
                end
                node = node.Parent
            end
        end
        -- Um mesmo brainrot pode possuir várias ProximityPrompts/labels clonadas.
        -- Usa o caminho do recipiente para preservar cópias reais e eliminar clones do mesmo item.
        local resultContainer = obj.Parent and obj.Parent:GetFullName() or tostring(obj)
        local resultKey
        if isBasePrompt then
            -- Prompts Steal clonados da mesma base são uma única ocorrência lógica.
            resultKey = table.concat({"base", tostring(displayName):lower(), tostring(math.floor(genValue or 0)), tostring(resultOwner)}, "|")
        else
            resultKey = table.concat({"carpet", tostring(displayName):lower(), tostring(math.floor(genValue or 0)), tostring(resultOwner), resultContainer}, "|")
        end
        if uniqueResults[resultKey] then
            continue
        end
        uniqueResults[resultKey] = true

        local result = {
            tier = tier,
            name = displayName,
            gen = genText,
            value = genValue,
            mutation = mutation,
            traits = traits,
            inDuel = false,
            ownerName = resultOwner,
            isCarpet = not isBasePrompt,
            isBase = isBasePrompt,
        }
        if isBasePrompt then
            table.insert(baseResults, result)
        else
            table.insert(results, result)
        end
        
        print(string.format("FOUND %s: %s | Owner: %s | Gen: %s", isBasePrompt and "BASE" or "CARPET", displayName, resultOwner, genText))
    end
    
    --print(string.format("[SCAN DEBUG] RESUMO: total=%d disabled=%d actionMismatch=%d purchase=%d semNome=%d blacklist=%d baixoValor=%d", promptTotal, disabledCount, actionMismatch, carpetCount, noNameCount, blacklistedCount, lowValueCount))
    --print(string.format("🎠 Carpet scan: %d prompts checked, %d qualifying", carpetCount, #results))
    --print(string.format("🏠 Steal/base prompts: %d qualifying", #baseResults))
    --print("[SCAN DEBUG] ===== FIM SCAN CARPET =====")
    return results, baseResults
end

-- ✅ SCAN DE BASES DOS JOGADORES via TextLabels
local function scanPlayerBases(seen, currentJobId)
    local results = {}
    local labelsChecked = 0
    local labelsQualifying = 0
    local uniqueBaseLabels = {}
    
    -- Buscar container de bases
    local basesContainer = Workspace:FindFirstChild("Plots")
    if not basesContainer then
        -- Tentar alternativas
        local alternatives = {"PlayerPlots", "Bases", "PlayerBases"}
        for _, alt in ipairs(alternatives) do
            basesContainer = Workspace:FindFirstChild(alt)
            if basesContainer then break end
        end
    end
    
    if not basesContainer then
        --print("🏠 Player bases: container não encontrado")
        return results
    end
    
    -- Escanear cada base
    for _, base in ipairs(basesContainer:GetChildren()) do
        -- Buscar owner da base
        local ownerName = base:GetAttribute("Owner") or base:GetAttribute("PlayerName")
        if not ownerName then
            -- Tentar pelo nome da base (alguns jogos usam player name como nome da base)
            for _, player in ipairs(Players:GetPlayers()) do
                if player.Name == base.Name or tostring(player.UserId) == base.Name then
                    ownerName = player.Name
                    break
                end
            end
        end
        
        if not ownerName then
            ownerName = "Unknown"
        else
            ownerName = tostring(ownerName)
        end
        
        -- Buscar TextLabels com padrão $XXX.XM/s
        for _, obj in ipairs(base:GetDescendants()) do
            if not obj:IsA("TextLabel") then continue end
            
            local text = obj.Text or ""
            -- Padrão: $XXX.XM/s, $XXX.XK/s, $XXX.XB/s, etc
            local valueMatch = text:match("%$([%d%.]+)([KMBTkmbt])%/?s?")
            
            if valueMatch then
                labelsChecked = labelsChecked + 1
                
                -- Parse do valor
                local numStr, suffix = text:match("([%d%.]+)([KMBTkmbt])")
                if not numStr then continue end
                
                local value = tonumber(numStr) or 0
                local multiplier = ({K=1e3, M=1e6, B=1e9, T=1e12, k=1e3, m=1e6, b=1e9, t=1e12})[suffix] or 1
                local genValue = value * multiplier
                
                -- Procurar o nome em labels próximas e nos ancestrais.
                -- O nome é resolvido contra AnimalsData para não transformar mutation/trait/número em brainrot.
                local brainrotName = nil
                local textCandidates = { text }
                local node = obj.Parent
                for _ = 1, 5 do
                    if not node or node == basesContainer then break end
                    table.insert(textCandidates, tostring(node.Name or ""))
                    for _, child in ipairs(node:GetChildren()) do
                        if child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("TextBox") then
                            table.insert(textCandidates, tostring(child.Text or ""))
                        elseif child:IsA("StringValue") then
                            table.insert(textCandidates, tostring(child.Value or ""))
                        end
                    end
                    node = node.Parent
                end
                if AnimalsData then
                    local bestLength = 0
                    for _, candidateText in ipairs(textCandidates) do
                        local lowText = tostring(candidateText):lower()
                        for candidate in pairs(AnimalsData) do
                            local candidateString = tostring(candidate)
                            if #candidateString > bestLength and lowText:find(candidateString:lower(), 1, true) then
                                brainrotName = candidateString
                                bestLength = #candidateString
                            end
                        end
                    end
                end
                if not brainrotName or brainrotName == "" then continue end

                -- Reutiliza a extração contextual: somente objetos/atributos marcados
                -- como Trait/Mutation entram no cálculo deste brainrot.
                local _, contextualValue, detectedMutation, detectedTraits = findPromptData(obj)
                local mutation = detectedMutation
                local traits = detectedTraits or {}
                if contextualValue and contextualValue > genValue then
                    genValue = contextualValue
                end
                if AnimalsData and AnimalsData[brainrotName] then
                    local calculatedValue = calculateGenValue(brainrotName, mutation, traits)
                    if calculatedValue and calculatedValue > 0 then
                        genValue = calculatedValue
                    end
                end
                
                -- ✅ FILTRO: Blacklist
                if isBlacklisted(brainrotName) then continue end
                
                -- ✅ FILTRO: MIN_VALUE
                if not (genValue >= MIN_VALUE or isTargeted(brainrotName) or isUltra(brainrotName)) then continue end
                
                -- Labels clonadas/replicadas da mesma base formam uma única ocorrência.
                local labelKey = table.concat({
                    tostring(brainrotName):lower(), tostring(math.floor(genValue or 0)),
                    tostring(ownerName)
                }, "|")
                if uniqueBaseLabels[labelKey] then continue end
                uniqueBaseLabels[labelKey] = true
                labelsQualifying = labelsQualifying + 1
                
                local genText = "$" .. formatValue(genValue) .. "/s"
                local tier = (genValue >= 1e9 or isUltra(brainrotName)) and "ULTRA" 
                          or (genValue >= 100e6) and "HIGH" 
                          or "MID"
                
                table.insert(results, {
                    tier = tier,
                    name = brainrotName .. " (base)",
                    gen = genText,
                    value = genValue,
                    mutation = nil,
                    traits = nil,
                    inDuel = false,
                    ownerName = ownerName,
                    isBase = true,
                })
                
                --print(string.format("✅ BASE: %s | Owner: %s | Gen: %s", brainrotName, ownerName, genText))
            end
        end
    end
    
    --print(string.format("🏠 Player bases: %d labels checked, %d qualifying", labelsChecked, labelsQualifying))
    return results
end

local function getBrainrotImage(name)
    local ok, result = pcall(function()
        local url = "https://stealabrainrot.fandom.com/api.php?action=query&titles="
                    .. HttpService:UrlEncode(name)
                    .. "&prop=pageimages&piprop=original&format=json"
        local resp = http_request({ Url = url, Method = "GET" })
        if resp and resp.StatusCode == 200 then
            local data = HttpService:JSONDecode(resp.Body)
            for _, page in pairs(data.query.pages) do
                if page.original and page.original.source then return page.original.source end
            end
        end
    end)
    return ok and result or nil
end

