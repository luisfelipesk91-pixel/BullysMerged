local function waitForScanReady()
    local timeoutAt = os.clock() + 25
    local lastPromptCount = -1
    --print("[SCAN READY] Aguardando mapa, prompts e AnimalsData...")
    while os.clock() < timeoutAt do
        if not game:IsLoaded() then game.Loaded:Wait() end

        -- Recarrega AnimalsData se o auto-execute tentou require cedo demais.
        if not AnimalsData or next(AnimalsData) == nil then
            pcall(function()
                local datas = RS:FindFirstChild("Datas")
                local animalsModule = datas and datas:FindFirstChild("Animals")
                if animalsModule then AnimalsData = require(animalsModule) end
            end)
        end

        local promptCount = 0
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") and obj.Enabled then
                promptCount = promptCount + 1
            end
        end
        if promptCount ~= lastPromptCount then
            debugLog("READY: prompts ativos=" .. tostring(promptCount) .. "; AnimalsData=" .. tostring(AnimalsData and next(AnimalsData) ~= nil))
            --print(string.format("[SCAN READY] prompts ativos=%d AnimalsData=%s", promptCount, tostring(AnimalsData and next(AnimalsData) ~= nil)))
            lastPromptCount = promptCount
        end

        if promptCount > 0 and AnimalsData and next(AnimalsData) ~= nil then
            task.wait(1.5)
            debugLog("READY: condições atendidas; iniciando scan")
            --print("[SCAN READY] Pronto; iniciando scan agora")
            return true
        end
        task.wait(1)
    end
    debugLog("READY: timeout; executando scan com dados disponíveis")
    --print("[SCAN READY] Timeout; executando scan com os dados disponíveis")
    return false
end

