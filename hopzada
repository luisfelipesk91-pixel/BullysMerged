                    elseif trait == "Bubblegum" then traitMod = 3
                    elseif trait == "UFO" then traitMod = 2
                    elseif trait == "Taco" then traitMod = 2
                    
                    -- TRAITS NATURAL EVENTS
                    elseif trait == "Cometstruck" or trait == "Comet-struck" then traitMod = 2.5
                    elseif trait == "Snowy" then traitMod = 2
                    elseif trait == "Wet" then traitMod = 1.5
                    
                    -- Sleepy (não soma aqui, aplicado depois)
                    elseif trait == "Sleepy" then traitMod = 0
                    end
                    
                    traitsSum = traitsSum + traitMod
                end
            end
            
            -- CALCULAR: Base × (Mutation + TraitsSum)
            genValue = baseGen * (mutationMod + traitsSum)
            
            -- Aplicar Sleepy por último (× 0.5)
            if traitsTable then
                for _, trait in ipairs(traitsTable) do
                    if trait == "Sleepy" then
                        genValue = genValue * 0.5
                        break
                    end
                end
            end
            
            if not genValue or genValue <= 0 then continue end
            
            local qualifies = shouldScan(name, genValue)
            
            if qualifies then plotHasQualifying = true end
            local displayName = name
            local info = AnimalsData[name]
            if info and info.DisplayName then displayName = info.DisplayName end
            table.insert(plotItems, {
                name = displayName, index = name, genValue = genValue,
                mutation = mutation, traitsList = traitsList,
                traitCount = traitsTable and #traitsTable or 0,
                inDuel = inDuel, qualifies = qualifies, ownerName = ownerName,
            })
        end
        
        if not plotHasQualifying then continue end
        
        for _, item in ipairs(plotItems) do
            if not item.qualifies then continue end
            local genText = "$" .. formatValue(item.genValue) .. "/s"
            table.insert(results, {
                tier = (item.genValue >= 1e9 or isUltra(item.name)) and "ULTRA" or (item.genValue >= 100e6) and "HIGH" or "MID",
                name = item.name, gen = genText, value = item.genValue,
                mutation = item.mutation, traits = #item.traitsList > 0 and item.traitsList or nil,
                inDuel = item.inDuel, ownerName = item.ownerName,
            })
            print(string.format("FOUND: %s | Mutation: %s | Traits: %d | Gen: %s", item.name, item.mutation or "None", item.traitCount, genText))
        end
    end
    
    return results
end

local function parseObjectText(objectText)
    if not objectText or objectText == "" then return nil, 0 end
    local name, valStr = objectText:match("^(.-)%s*%$([%d%.]+[KkMmBbTt]?)%s*$")
    if name and valStr then
        name = name:match("^%s*(.-)%s*$")
        return name, parseValue("$" .. valStr .. "/s")
    end
    return objectText:match("^%s*(.-)%s*$"), 0
end

local function scanCarpet(seen, currentJobId)
    local results = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if not obj:IsA("ProximityPrompt") or not obj.Enabled then continue end
        if (obj.ActionText or "") ~= "Purchase" then continue end
        local displayName, genValue = parseObjectText(obj.ObjectText)
        if not displayName or displayName == "" then continue end
        
        -- Usar mesma lógica dos plots para pegar valor base correto
        if AnimalsData and AnimalsData[displayName] then
            local baseGen = nil
            
            -- Método 1: GetGenerationNoTraits (retorna $/s base SEM mutation)
            if AnimalsShared then
                local ok1, result1 = pcall(function() return AnimalsShared:GetGenerationNoTraits(displayName, nil) end)
                if ok1 and type(result1) == "number" and result1 > 0 then 
                    baseGen = result1
                end
            end
            
            -- Fallback: Usar AnimalsData base
            if not baseGen then
                baseGen = AnimalsData[displayName].Generation
            end
            
            if baseGen and type(baseGen) == "number" and baseGen > 0 then
                genValue = baseGen
            end
        end
        if isBlacklisted(displayName) then continue end
        if not (genValue >= MIN_VALUE_CARPET or isTargeted(displayName) or isUltra(displayName)) then continue end
        local genText = genValue > 0 and ("$" .. formatValue(genValue) .. "/s") or "?"
        table.insert(results, {
            tier = (genValue >= 1e9 or isUltra(displayName)) and "ULTRA" or (genValue >= 100e6) and "HIGH" or "MID",
            name = displayName .. " (carpet)", gen = genText, value = genValue,
            mutation = nil, traits = nil, inDuel = false, ownerName = "Carpet", isCarpet = true,
        })
        print(string.format("✅ CARPET FOUND: %s | Gen: %s", displayName, genText))
    end
    return results
end

