end

local function parseObjectText(objectText)
    if not objectText or objectText == "" then return nil, 0 end
    
    -- Remove tags de RichText (ex: <font color="...">)
    local cleanText = objectText:gsub("<[^>]+>", "")
    -- Limpa caracteres especiais invisíveis
    cleanText = cleanText:gsub("[\128-\255]", "")
    
    local lines = cleanText:split("\n")
    local name = "Unknown"
    local genValue = 0
    
    for _, line in ipairs(lines) do
        local trimmed = line:match("^%s*(.-)%s*$")
        if trimmed ~= "" then
            -- Procura valor /s
            local genStr = trimmed:match("%$([%d%.]+[KkMmBbTt]?)/[Ss]")
            if genStr then
                genValue = parseValue("$" .. genStr .. "/s")
            -- Se não for valor nem preço, assume que é o nome (se ainda não tiver um)
            elseif name == "Unknown" and not trimmed:find("%$") and not trimmed:find("/") and #trimmed > 2 then
                name = trimmed
            end
        end
    end
    
    return name, genValue
end

local function getPlotAtPosition(pos)
    local plots = Workspace:FindFirstChild("Plots")
    if not plots then return nil end
    for _, plot in ipairs(plots:GetChildren()) do
        local base = plot:FindFirstChild("Base") or plot:FindFirstChild("Hitbox") or plot:FindFirstChild("Floor")
        if base and base:IsA("BasePart") then
            local p = base.Position
            local s = base.Size
            -- Aumentado para +15 para garantir detecção em bordas e Debris
            if math.abs(pos.X - p.X) <= s.X/2 + 15 and math.abs(pos.Z - p.Z) <= s.Z/2 + 15 then
                return plot
            end
        end
    end
    -- Fallback: Se não achou pela base, tenta por distância do centro do plot
    for _, plot in ipairs(plots:GetChildren()) do
        local center = plot:FindFirstChild("Base") or plot:FindFirstChild("Hitbox") or plot:FindFirstChild("Spawn")
        if center and center:IsA("BasePart") then
            local dist = (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(center.Position.X, 0, center.Position.Z)).Magnitude
            if dist < 60 then return plot end
        end
    end
    return nil
end

