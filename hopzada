                    -- Tenta pegar a posição pelo Adornee (BillboardGui/SurfaceGui) ou pelo objeto físico
                    local pos = nil
                    if obj:IsA("GuiObject") or obj:IsA("LayerCollector") then
                        local root = obj:FindFirstAncestorWhichIsA("BillboardGui") or obj:FindFirstAncestorWhichIsA("SurfaceGui")
                        if root and root.Adornee then pos = root.Adornee.Position end
                    end
                    
                    if not pos then
                        pos = (obj:IsA("BasePart") and obj.Position) or (obj.Parent:IsA("BasePart") and obj.Parent.Position)
                    end
                    
                    if not pos and obj:FindFirstAncestorWhichIsA("BasePart") then
                        pos = obj:FindFirstAncestorWhichIsA("BasePart").Position
                    end
                    
                    if pos then
                        local plot = getPlotAtPosition(pos)
                        if plot then
                            ownerName = plot:GetAttribute("Owner") or plot:GetAttribute("PlayerName") or plot.Name
                            isCarpet = false
                        end
                    end

                    table.insert(results, {
                        tier = (genValue >= 1e9 or isUltra(finalDisplayName)) and "ULTRA" or (genValue >= 100e6) and "HIGH" or "MID",
                        name = finalDisplayName, gen = genText, value = genValue,
                        mutation = nil, traits = nil, inDuel = false, ownerName = ownerName, isCarpet = isCarpet,
                    })
                    print(string.format("✅ %s FOUND: %s | Owner: %s | Gen: %s", isCarpet and "CARPET" or "PLOT", finalDisplayName, ownerName, genText))
                end
            end
        end
    end
    return results
end

local function getBrainrotImage(name)
    local ok, result = pcall(function()
        local url = "https://stealabrainrot.fandom.com/api.php?action=query&titles="
                    .. HttpService:UrlEncode(name)
                    .. "&prop=pageimages&piprop=original&format=json"
        local resp = http_request({ Url = url, Method = "GET" })
        if resp and resp.StatusCode == 200 then
            local data = HttpService:JSONDecode(resp.Body)
            for _, page in pairs(data.query.pages) do
                if page.original and page.original.source then return page.original.source end
            end
        end
    end)
    return ok and result or nil
end

