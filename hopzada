            if textToParse ~= "" and textToParse:find("/s") then
                local dName, gVal = parseObjectText(textToParse)
                if dName == "Unknown" and obj.Parent then
                    for _, sib in ipairs(obj.Parent:GetChildren()) do
                        local sibText = (sib:IsA("TextLabel") or sib:IsA("TextButton")) and sib.Text or (sib:IsA("ProximityPrompt") and sib.ObjectText) or ""
                        if sibText ~= "" and sib ~= obj then
                            local sn, _ = parseObjectText(sibText)
                            if sn ~= "Unknown" then dName = sn; break end
                        end
                    end
                end

                if dName ~= "Unknown" and shouldScan(dName, gVal) then
